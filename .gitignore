.env
/storage/logs/*
!/storage/logs/.gitkeep
/storage/cache/*
!/storage/cache/.gitkeep
/storage/backups/*
!/storage/backups/.gitkeep
/storage/sessions/*
/storage/reports/*
/storage/deployments/*
/storage/releases/*
!/storage/releases/.gitkeep
/public/uploads/*
!/public/uploads/*/.gitkeep
*.zip
*.sha256
