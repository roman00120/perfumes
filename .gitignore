.env
/storage/logs/*
!/storage/logs/.gitkeep
/storage/cache/*
!/storage/cache/.gitkeep
/storage/backups/*
!/storage/backups/.gitkeep
/storage/sessions/*
/storage/reports/*
/storage/deployments/*
/storage/releases/*
!/storage/releases/.gitkeep
/public/uploads/*
!/public/uploads/*/.gitkeep
!/public/uploads/perfumes/
/public/uploads/perfumes/*
!/public/uploads/perfumes/.gitkeep
!/public/uploads/perfumes/reference-*.png
*.zip
*.sha256
